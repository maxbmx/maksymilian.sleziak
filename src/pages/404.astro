---
import Button from "../components/Button.astro";
import Base from "../layouts/Base.astro";
import { notFound, person } from "../content";
---

<Base title={`${notFound.title} | ${person.name}`} noindexOverride={true}>
  <main id="tresc" class="not-found" data-grid="32y">
    <div class="container" data-snap data-grid="32">
      <h1>{notFound.title}</h1>
      <p>{notFound.text}</p>
      <p>
        <Button large href="/">
          {notFound.cta}
        </Button>
      </p>
    </div>
  </main>
</Base>

<style>
  .not-found {
    padding-block: var(--section-pad);
  }

  .not-found p {
    margin-top: var(--s-4);
  }
</style>
