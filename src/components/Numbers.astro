---
import { numbers } from "../content";
---

<section class="row" aria-label={numbers.label} data-grid="32y">
  <dl class="container numbers">
    {numbers.items.map((item) => (
      <div class="number" data-snap data-grid="32">
        <dt>{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .numbers {
    display: grid;
    grid-template-columns: var(--w);
    text-align: center;
  }

  .number {
    display: flex;
    flex-direction: column-reverse;
    padding-block: var(--s-4);
  }

  /*
   * Od 768 px liczby i opisy leżą we wspólnych wierszach wszystkich trzech kolumn (subgrid).
   * Gdy w którejś kolumnie liczba zawinie się do dwóch wierszy (szerszy font systemowy),
   * opisy pod spodem nadal stoją na jednej linii.
   */
  dd {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--fs-display-2);
    line-height: var(--lh-display-2);
    letter-spacing: var(--ls-display-2);
    overflow-wrap: break-word;
  }

  @container page (min-width: 48rem) {
    .numbers {
      grid-template-columns: repeat(3, var(--col-3));
      grid-template-rows: auto auto;
      column-gap: var(--gutter);
    }

    .number {
      display: grid;
      grid-row: span 2;
      grid-template-rows: subgrid;
      padding-block: var(--s-8);
    }

    dd {
      grid-row: 1;
    }

    dt {
      grid-row: 2;
    }
  }
</style>
